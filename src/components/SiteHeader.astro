---
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#0b6e5b"></rect>
        <circle cx="16" cy="17" r="8" fill="#ffffff"></circle>
        <path d="M16 6l2.2 4.2H14z" fill="#d7f3ea"></path>
      </svg>
      Background Remover
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/#how-it-works">How it works</a>
      <a href="/#faq">FAQ</a>
      <a href="/privacy/" aria-current={path.startsWith('/privacy') ? 'page' : undefined}>Privacy</a>
      <a href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Contact</a>
    </nav>
  </div>
</header>

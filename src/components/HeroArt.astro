<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 420 320" role="img">
    <title>Illustration of a cutout on a checkerboard</title>
    <rect x="16" y="20" width="180" height="280" rx="18" fill="#f4f7f5" stroke="#d5e2dc"></rect>
    <rect x="40" y="58" width="132" height="168" rx="66" fill="#d7efe6"></rect>
    <circle cx="106" cy="132" r="38" fill="#0b6e5b"></circle>
    <rect x="78" y="176" width="56" height="70" rx="28" fill="#0b6e5b"></rect>
    <rect x="224" y="20" width="180" height="280" rx="18" fill="#ffffff" stroke="#d5e2dc"></rect>
    <g>
      <defs>
        <pattern id="checks" width="20" height="20" patternUnits="userSpaceOnUse">
          <rect width="20" height="20" fill="#ffffff"></rect>
          <rect width="10" height="10" fill="#d7e3de"></rect>
          <rect x="10" y="10" width="10" height="10" fill="#d7e3de"></rect>
        </pattern>
        <clipPath id="subject">
          <circle cx="314" cy="132" r="38"></circle>
          <rect x="286" y="176" width="56" height="70" rx="28"></rect>
        </clipPath>
      </defs>
      <rect x="248" y="58" width="132" height="188" rx="16" fill="url(#checks)"></rect>
      <g clip-path="url(#subject)">
        <rect x="248" y="58" width="132" height="188" fill="#147864"></rect>
      </g>
    </g>
  </svg>
</div>

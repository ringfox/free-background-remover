# Public base for the ISNet part files. Trailing slash optional.
# Parts are fetched as ${PUBLIC_MODEL_BASE_URL}/isnet-w8.part00 (and part01, part02).
# Those three objects are live on this host. The default in source matches this URL when the variable is unset.
# Override it (for example /models/) to use a local copy instead.
PUBLIC_MODEL_BASE_URL=https://pub-8351688b2a9b42318f662dc52714bef3.r2.dev/models

# ONNX Runtime wasm/js. Leave as /ort/ to use the files copied into the Pages build.
# WebGPU needs the larger runtime files, which are over Pages' 25 MiB asset limit.
# After `npm run runtime:upload`, set this and rebuild:
# PUBLIC_ORT_BASE_URL=https://pub-8351688b2a9b42318f662dc52714bef3.r2.dev/ort
PUBLIC_ORT_BASE_URL=/ort/

# Canonical origin used for Open Graph, robots.txt, and the sitemap. No trailing path.
PUBLIC_SITE_URL=https://bg.example.com

# Shown on the contact, privacy, and terms pages. Not a secret.
PUBLIC_CONTACT_EMAIL=privacy@example.com

# The UI mock (`/?mock=1`) exists only in `astro dev`. Production builds ignore it.
